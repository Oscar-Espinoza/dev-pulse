# Postgres connection string. Neon URLs work as-is (pooled or direct);
# plain postgresql:// is normalized to postgresql+asyncpg:// automatically.
DATABASE_URL=postgresql://devpulse:devpulse@localhost:5432/devpulse
# Log SQL statements (dev only)
ECHO_SQL=false
# Emit JSON logs (enable in production)
JSON_LOGS=false
# Per-user limits
MAX_ACTIVE_MONITORS_PER_USER=20
MIN_INTERVAL_SECONDS=60
# Outbound HTTP check timeout (seconds)
HTTP_TIMEOUT_SECONDS=10.0
# Serve the MCP endpoint at /mcp for LLM clients
MCP_ENABLED=true
# This service's public origin. OAuth discovery metadata advertises absolute
# URLs built from it, so it must match how clients actually reach you. A bare
# hostname is accepted and assumed to be https.
MCP_BASE_URL=http://localhost:8000
